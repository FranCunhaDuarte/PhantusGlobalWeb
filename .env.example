# Envío del formulario de contacto.
#
# Sin RESEND_API_KEY la acción no falla: arma el mail, lo sanitiza igual que en
# producción, lo escribe al log del servidor marcado como ENVÍO SIMULADO y le
# devuelve la confirmación al visitante. Así se prueba el flujo entero sin
# cuenta. Ninguna de las tres tiene valor por defecto en el código.

# Clave de API de Resend (https://resend.com/api-keys).
RESEND_API_KEY=

# Casilla que recibe las consultas.
CONTACTO_DESTINO=

# Remitente verificado en Resend. Admite "Nombre <casilla@dominio>".
CONTACTO_REMITENTE=

# Cuántos proxies de confianza hay delante de la app, para saber qué entrada de
# `x-forwarded-for` es la IP real del visitante. Por defecto 1, que es el
# reverse proxy del VPS. Si la app queda expuesta directo a internet, el dato
# deja de ser confiable y el límite de envíos se puede burlar cambiando la
# cabecera.
CONTACTO_PROXIES_DE_CONFIANZA=1

# Origen público del sitio. Se usa para el sitemap, los alternates y la
# metadata; en producción manda el dominio de la marca.
NEXT_PUBLIC_SITIO_URL=
